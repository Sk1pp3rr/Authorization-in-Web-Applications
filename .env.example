# ====================================================================
# Konfiguracja środowiskowa - Szablon (.env.example)
#
# Aby uruchomić aplikację lokalnie:
# 1. Skopiuj ten plik do pliku o nazwie .env:
#    cp .env.example .env (lub copy .env.example .env w Windows CMD)
# 2. Uzupełnij poniższe zmienne swoimi danymi z Google Cloud Console
# ====================================================================

# GOOGLE_CLIENT_ID:
# Publiczny identyfikator klienta OAuth 2.0 wygenerowany w Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client IDs).
# Identyfikuje Twoją aplikację podczas żądania logowania użytkownika przez Google.
GOOGLE_CLIENT_ID=twoj_klient_id.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET:
# Tajny klucz aplikacji klienckiej (Client Secret) powiązany z GOOGLE_CLIENT_ID.
# Używany wyłącznie po stronie serwera w protokole OAuth 2.0 do bezpiecznej wymiany
# tymczasowego kodu autoryzacji na token dostępu (access token).
# UWAGA: Nigdy nie udostępniaj tego klucza publicznie ani nie dodawaj go do repozytorium!
GOOGLE_CLIENT_SECRET=twoj_tajny_klucz_klienta

# GOOGLE_CALLBACK_URL:
# Adres URL przekierowania (redirect URI) po poprawnym uwierzytelnieniu w Google.
# Musi być dokładnie taki sam jak adres dodany w Google Cloud Console w sekcji
# "Authorized redirect URIs". Domyślnie dla testów lokalnych: http://localhost:8080/callback
GOOGLE_CALLBACK_URL=http://localhost:8080/callback
